# 4. class-averaged CAM weights
def pooled_grads(arr, class_index):
    with tf.GradientTape() as tape:
        cf = base(arr, training=False)
        tape.watch(cf)
        y = cf
        for l in head_layers:
            y = l(y, training=False)
        score = y[:, class_index]
    g = tape.gradient(score, cf)
    return tf.reduce_mean(g, axis=(0, 1, 2)).numpy()
 
 
NUM_CH = base.output_shape[-1]
SAMPLES = 60
weights = np.zeros((NUM_CLASSES, NUM_CH), dtype=np.float32)
rng = np.random.default_rng(SEED)
 
for ci, cname in enumerate(target_names):
    d = os.path.join(SPLIT_BASE, 'train', cname)
    files = [os.path.join(d, f) for f in os.listdir(d) if f.lower().endswith(EXTS)]
    pick = rng.choice(files, size=min(SAMPLES, len(files)), replace=False)
    acc = np.zeros(NUM_CH, dtype=np.float32)
    for fp in pick:
        im = Image.open(fp).convert('RGB').resize((IMG_SIZE, IMG_SIZE))
        arr = preprocess_input(np.expand_dims(np.array(im, dtype='float32'), 0))
        acc += pooled_grads(arr, ci)
    weights[ci] = acc / len(pick)
    print(f'  {cname:<22} CAM signature from {len(pick)} images')
 
