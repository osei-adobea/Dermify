# ── CELL 16: GRAD-CAM VISUALISATION ───────────────────────────────────
# Reuses: model, base, test_data, target_names, y_true, y_pred, IMG_SIZE
#
# NOTE ON NAMING — this matters for your slides:
#   This cell computes TRUE Grad-CAM: per-image gradients via GradientTape,
#   at evaluation time, in Python.
#   The ANDROID APP computes CAM: it multiplies the exported feature maps
#   by the class-averaged gradient weights in cam_class_weights.json,
#   because TFLite cannot compute gradients at inference time.
#   Both are legitimate. Label the app's version "CAM", not "Grad-CAM".
#
# WHY IT IS WRITTEN THIS WAY: in Keras 3, rebuilding a graph from a nested
# model's .output raises a KeyError. So instead of constructing a new
# Model, we call `base` directly and chain the head layers manually inside
# the tape. Plain eager execution, version-robust.

base_layer_index = next(i for i, l in enumerate(model.layers) if l.name == base.name)
head_layers_gc = model.layers[base_layer_index + 1:]


def make_gradcam_heatmap(img_preprocessed, pred_index=None):
    """img_preprocessed: (1,224,224,3) already through preprocess_input.
    Returns (7x7 heatmap in [0,1], predicted index, softmax probs)."""
    with tf.GradientTape() as tape:
        conv_out = base(img_preprocessed, training=False)
        tape.watch(conv_out)                 # not a Variable — must watch
        x = conv_out
        for l in head_layers_gc:
            x = l(x, training=False)
        preds = x
        if pred_index is None:
            pred_index = tf.argmax(preds[0])
        score = preds[:, pred_index]

    grads = tape.gradient(score, conv_out)
    pooled = tf.reduce_mean(grads, axis=(0, 1, 2))

    hm = conv_out[0] @ pooled[..., tf.newaxis]
    hm = tf.squeeze(hm)
    hm = tf.maximum(hm, 0) / (tf.math.reduce_max(hm) + 1e-8)
    return hm.numpy(), int(pred_index), preds.numpy()[0]


def overlay_heatmap(img_path, heatmap, alpha=0.4):
    """Upsample the coarse 7x7 map to 224x224 and blend with the image."""
    img = Image.open(img_path).convert('RGB').resize((IMG_SIZE, IMG_SIZE))
    arr = np.array(img)
    hm8 = np.uint8(255 * heatmap)
    hm_big = np.array(Image.fromarray(hm8).resize((IMG_SIZE, IMG_SIZE)))
    jet = plt.cm.jet(hm_big / 255.0)[:, :, :3] * 255
    return arr, (jet * alpha + arr * (1 - alpha)).astype('uint8')


def gradcam_for_image(img_path):
    img = Image.open(img_path).convert('RGB').resize((IMG_SIZE, IMG_SIZE))
    raw = np.expand_dims(np.array(img, dtype='float32'), 0)
    pre = preprocess_input(raw.copy())
    hm, idx, probs = make_gradcam_heatmap(pre)
    original, overlay = overlay_heatmap(img_path, hm)
    return {'original': original, 'overlay': overlay,
            'predicted_class': target_names[idx],
            'confidence': float(probs[idx])}


