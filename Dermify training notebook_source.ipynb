# ---- TRAINING ----
EPOCHS_P1      = 30         # frozen base
EPOCHS_P2      = 30         # fine-tune
UNFREEZE_FROM  = 165        # B0 has ~240 layers
LR_P1          = 1e-3
LR_P2          = 2e-5
LABEL_SMOOTH   = 0.05
 
# ---- REGULARISATION ----
DROPOUT_1      = 0.50
DROPOUT_2      = 0.40
L2_REG         = 1e-4
 
# ---- TTA ----
TTA_ROTATIONS  = (-10, 10)
TTA_USE_FLIP   = True
 
print('TensorFlow :', tf.__version__)
print('GPU        :', tf.config.list_physical_devices('GPU'))
print('Backbone   : EfficientNetB0 @', IMG_SIZE)
print('Classes    :', CLASS_NAMES)


# ── CELL 2: INVENTORY ─────────────────────────────────────────────────
all_images, all_labels = [], []
for cls in CLASS_NAMES:
    d = os.path.join(DATASET_PATH, cls)
    for f in sorted(os.listdir(d)):
        if f.lower().endswith(EXTS):
            all_images.append(os.path.join(d, f))
            all_labels.append(cls)
 
total = len(all_images)
print('=' * 56)
print(f'  {"Class":<24}{"Count":>7}{"Share":>10}')
print('=' * 56)
for cls in CLASS_NAMES:
    n = all_labels.count(cls)
    print(f'  {cls:<24}{n:>7}{n/total*100:>9.1f}%')
print('=' * 56)
print(f'  {"TOTAL":<24}{total:>7}{100.0:>9.1f}%')


# ── CELL 3: DEDUPLICATION (LEAKAGE PREVENTION) ────────────────────────
# Public derm datasets (Fitzpatrick17k, DermNet, SkinDisNet, Atlas) share
# images. The SAME photo under two filenames landing in train and test
# inflates test accuracy. MD5 misses resized/recompressed copies, so we
# use a perceptual hash and cluster with union-find.
 
def phash(path, hash_size=PHASH_SIZE):
    img = Image.open(path).convert('L').resize(
        (hash_size * 4, hash_size * 4), Image.LANCZOS)
    px = np.asarray(img, dtype=np.float32)
 
    def dct_1d(a):
        N = a.shape[-1]; k = np.arange(N)
        M = np.cos(np.pi * (2 * k[None, :] + 1) * k[:, None] / (2 * N))
        return a @ M.T
 
    dct = dct_1d(dct_1d(px).T).T
    low = dct[:hash_size, :hash_size]
    med = np.median(low[1:, 1:])
    v = 0
    for b in (low > med).flatten():
        v = (v << 1) | int(b)
    return v
 
 
def hamming(a, b):
    return bin(a ^ b).count('1')
 
 
print('Hashing images...')
hashes = []
for i, p in enumerate(all_images):
    try:
        hashes.append(phash(p))
    except Exception as e:
        print(f'  WARNING could not hash {os.path.basename(p)}: {e}')
        hashes.append(None)
    if (i + 1) % 500 == 0:
        print(f'  ...{i+1}/{total}')
 
parent = list(range(total))
 
def find(x):
    while parent[x] != x:
        parent[x] = parent[parent[x]]
        x = parent[x]
    return x
 
def union(a, b):
    ra, rb = find(a), find(b)
    if ra != rb:
        parent[rb] = ra
 
print('Clustering duplicates...')
for i in range(total):
    if hashes[i] is None:
        continue
    for j in range(i + 1, total):
        if hashes[j] is None:
            continue
        if hamming(hashes[i], hashes[j]) <= HAMMING_THRESH:
            union(i, j)
 
groups = defaultdict(list)
for i in range(total):
    groups[find(i)].append(i)
 
group_ids   = list(groups.keys())
group_label = {}
for g in group_ids:
    ls = [all_labels[i] for i in groups[g]]
    group_label[g] = max(set(ls), key=ls.count)
 
n_dupe_groups = sum(1 for g in group_ids if len(groups[g]) > 1)
n_redundant   = sum(len(groups[g]) - 1 for g in group_ids if len(groups[g]) > 1)
 
print()
print(f'  Images            : {total}')
print(f'  Unique groups     : {len(group_ids)}')
print(f'  Groups with dupes : {n_dupe_groups}')
print(f'  Redundant copies  : {n_redundant}')
if len(group_ids) < total * 0.5:
    print('  !! Threshold may be too loose — groups collapsed. Lower HAMMING_THRESH.')


# ── CELL 4: GROUP-AWARE SPLIT ─────────────────────────────────────────
# Split by GROUP so every copy of an image lands in the same split.
 
g_arr = np.array(group_ids)
g_lab = np.array([group_label[g] for g in group_ids])
 
g_tv, g_test = train_test_split(
    g_arr, test_size=0.15, random_state=SEED, stratify=g_lab)
g_tv_lab = np.array([group_label[g] for g in g_tv])
g_train, g_val = train_test_split(
    g_tv, test_size=0.176, random_state=SEED, stratify=g_tv_lab)
 
 
def expand(gs):
    ps, ls = [], []
    for g in gs:
        for i in groups[g]:
            ps.append(all_images[i]); ls.append(all_labels[i])
    return ps, ls
 
 
X_train, y_train = expand(g_train)
X_val,   y_val   = expand(g_val)
X_test,  y_test  = expand(g_test)
 
# ---- verify no leakage ----
split_of = {}
for p in X_train: split_of[p] = 'train'
for p in X_val:   split_of[p] = 'val'
for p in X_test:  split_of[p] = 'test'
 
violations = 0
for g in group_ids:
    if len(groups[g]) > 1:
        if len({split_of[all_images[i]] for i in groups[g]}) > 1:
            violations += 1
 
print(f'Duplicate groups spanning splits: {violations}  (must be 0)')
assert violations == 0, 'LEAKAGE — do not train on this split.'
print('No cross-split leakage.\n')
 
# ---- materialise ----
if os.path.exists(SPLIT_BASE):
    shutil.rmtree(SPLIT_BASE)
 
def materialise(paths, labels, split):
    for p, l in zip(paths, labels):
        d = os.path.join(SPLIT_BASE, split, l)
        os.makedirs(d, exist_ok=True)
        shutil.copy2(p, d)
 
materialise(X_train, y_train, 'train')
materialise(X_val,   y_val,   'val')
materialise(X_test,  y_test,  'test')
 
print('=' * 68)
print(f'  {"Split":<12}{"Total":>7}{"Share":>9}   ' +
      '  '.join(f'{c[:7]:>8}' for c in CLASS_NAMES))
print('=' * 68)
for name, X, y in [('Train', X_train, y_train),
                   ('Validation', X_val, y_val),
                   ('Test', X_test, y_test)]:
    per = '  '.join(f'{y.count(c):>8}' for c in CLASS_NAMES)
    print(f'  {name:<12}{len(X):>7}{len(X)/total*100:>8.1f}%   {per}')
print('=' * 68)
print('Percentages drift slightly from 70/15/15 because groups move as units.')
 


# ── CELL 5: GENERATORS (augmentation on TRAIN only) ───────────────────
train_gen = ImageDataGenerator(
    preprocessing_function=preprocess_input,
    rotation_range=25,
    width_shift_range=0.2,
