# ── CELL 11: TEST-TIME AUGMENTATION ───────────────────────────────────
# Averages predictions over original + h-flip + small rotations.
# Legitimate, standard, and reported alongside the plain number.
 
def stack_generator(gen):
    gen.reset()
    return np.concatenate([gen[i][0] for i in range(len(gen))], axis=0)
 
 
def predict_tta(model, X, rotations=TTA_ROTATIONS, use_flip=TTA_USE_FLIP):
    views = [model.predict(X, verbose=0)]
    if use_flip:
        views.append(model.predict(X[:, :, ::-1, :], verbose=0))
    for ang in rotations:
        Xr = ndimage.rotate(X, ang, axes=(1, 2), reshape=False,
                            order=1, mode='nearest')
        views.append(model.predict(Xr, verbose=0))
    return np.mean(views, axis=0)
 
 
X_test_arr = stack_generator(test_data)
test_data.reset()
y_true = test_data.classes
 
probs_plain = model.predict(X_test_arr, verbose=0)
acc_plain = accuracy_score(y_true, np.argmax(probs_plain, axis=1))
 
probs_tta = predict_tta(model, X_test_arr)
y_pred_tta = np.argmax(probs_tta, axis=1)
acc_tta = accuracy_score(y_true, y_pred_tta)
 
print(f'  Test, plain : {acc_plain*100:.2f}%')
print(f'  Test, TTA   : {acc_tta*100:.2f}%   (delta {(acc_tta-acc_plain)*100:+.2f})')
 
# use TTA predictions for the reported metrics below
y_pred, probs = y_pred_tta, probs_tta


# ── CELL 12: CROSS-VALIDATION (the number to present) ─────────────────
# Single splits of ~300 images are noisy. CV uses every image as test
# exactly once and reports mean +/- std, which removes the val-vs-test
# argument entirely. Folds are built over duplicate GROUPS.
#
# Costs 5 training runs. Reduce CV_EPOCHS_* if time is short.
 
RUN_CV       = True
N_FOLDS      = 5
CV_EPOCHS_P1 = 20
CV_EPOCHS_P2 = 20
CV_BASE      = '/kaggle/working/cv_split'
 
if RUN_CV:
    skf = StratifiedKFold(n_splits=N_FOLDS, shuffle=True, random_state=SEED)
    fold_plain, fold_tta, fold_reports = [], [], []
 
    for fold, (tr_idx, te_idx) in enumerate(skf.split(g_arr, g_lab), start=1):
        print('\n' + '=' * 56)
        print(f'  FOLD {fold}/{N_FOLDS}')
        print('=' * 56)
 
        tr_groups, te_groups = g_arr[tr_idx], g_arr[te_idx]
        inner_lab = [group_label[g] for g in tr_groups]
        tr_g, va_g = train_test_split(tr_groups, test_size=0.15,
                                      random_state=SEED, stratify=inner_lab)
 
        Xtr, ytr = expand(tr_g)
        Xva, yva = expand(va_g)
        Xte, yte = expand(te_groups)
 
        fdir = os.path.join(CV_BASE, f'fold{fold}')
        if os.path.exists(fdir):
            shutil.rmtree(fdir)
        for X, y, sp in [(Xtr, ytr, 'train'), (Xva, yva, 'val'), (Xte, yte, 'test')]:
            for p, l in zip(X, y):
                d = os.path.join(fdir, sp, l)
                os.makedirs(d, exist_ok=True)
                shutil.copy2(p, d)
        print(f'  train={len(Xtr)}  val={len(Xva)}  test={len(Xte)}')
 
        f_train = train_gen.flow_from_directory(
            os.path.join(fdir, 'train'), target_size=(IMG_SIZE, IMG_SIZE),
            batch_size=BATCH_SIZE, class_mode='categorical', shuffle=True, seed=SEED)
        f_val = eval_gen.flow_from_directory(
            os.path.join(fdir, 'val'), target_size=(IMG_SIZE, IMG_SIZE),
            batch_size=BATCH_SIZE, class_mode='categorical', shuffle=False)
        f_test = eval_gen.flow_from_directory(
            os.path.join(fdir, 'test'), target_size=(IMG_SIZE, IMG_SIZE),
            batch_size=BATCH_SIZE, class_mode='categorical', shuffle=False)
 
        fcw = compute_class_weight('balanced', classes=np.unique(ytr), y=ytr)
        fcwd = {f_train.class_indices[c]: w for c, w in zip(np.unique(ytr), fcw)}
 
        fmodel, fbase = build_model()
        fmodel.compile(optimizer=Adam(LR_P1),
                       loss=keras.losses.CategoricalCrossentropy(label_smoothing=LABEL_SMOOTH),
                       metrics=['accuracy'])
        fcb = [EarlyStopping(monitor='val_accuracy', patience=8,
                             restore_best_weights=True, verbose=0)]
 
        print('  Phase 1...')
        fmodel.fit(f_train, epochs=CV_EPOCHS_P1, validation_data=f_val,
                   class_weight=fcwd, callbacks=fcb, verbose=0)
 
        fbase.trainable = True
        for i, layer in enumerate(fbase.layers):
            if i < UNFREEZE_FROM or isinstance(layer, layers.BatchNormalization):
                layer.trainable = False
        fsteps = int(np.ceil(f_train.samples / BATCH_SIZE))
        fmodel.compile(
            optimizer=Adam(keras.optimizers.schedules.CosineDecay(
                LR_P2, CV_EPOCHS_P2 * fsteps)),
            loss=keras.losses.CategoricalCrossentropy(label_smoothing=LABEL_SMOOTH),
            metrics=['accuracy'])
 
        print('  Phase 2...')
        fmodel.fit(f_train, epochs=CV_EPOCHS_P2, validation_data=f_val,
                   class_weight=fcwd, callbacks=fcb, verbose=0)
 
        f_test.reset()
        fy_true = f_test.classes
        fX = stack_generator(f_test)
        fp = fmodel.predict(fX, verbose=0)
        fa_plain = accuracy_score(fy_true, np.argmax(fp, axis=1))
        ft = predict_tta(fmodel, fX)
        fy_pred = np.argmax(ft, axis=1)
        fa_tta = accuracy_score(fy_true, fy_pred)
 
        fold_plain.append(fa_plain)
        fold_tta.append(fa_tta)
        fidx = {v: k for k, v in f_test.class_indices.items()}
        fold_reports.append(classification_report(
            fy_true, fy_pred, target_names=[fidx[i] for i in sorted(fidx)],
            output_dict=True, zero_division=0))
 
        print(f'  FOLD {fold}: plain {fa_plain*100:.2f}%   TTA {fa_tta*100:.2f}%')
 
        del fmodel, fbase
        keras.backend.clear_session()
        gc.collect()
 
    ap, at = np.array(fold_plain) * 100, np.array(fold_tta) * 100
    ci = 1.96 * at.std() / np.sqrt(N_FOLDS)
 
    print('\n' + '=' * 60)
    print('     DERMIFY — 5-FOLD CROSS-VALIDATION')
    print('=' * 60)
    for i, (a, b) in enumerate(zip(ap, at), 1):
