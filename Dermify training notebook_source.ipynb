    batch_size=BATCH_SIZE, class_mode='categorical', shuffle=False)
 
test_data = eval_gen.flow_from_directory(
    os.path.join(SPLIT_BASE, 'test'), target_size=(IMG_SIZE, IMG_SIZE),
    batch_size=BATCH_SIZE, class_mode='categorical', shuffle=False)
 
# a NON-augmented view of train, for honest train-vs-val gap checks
train_eval_data = eval_gen.flow_from_directory(
    os.path.join(SPLIT_BASE, 'train'), target_size=(IMG_SIZE, IMG_SIZE),
    batch_size=BATCH_SIZE, class_mode='categorical', shuffle=False)
 
idx_to_class = {v: k for k, v in train_data.class_indices.items()}
target_names = [idx_to_class[i] for i in sorted(idx_to_class)]
 
cw = compute_class_weight('balanced', classes=np.unique(y_train), y=y_train)
class_weight_dict = {train_data.class_indices[c]: w
                     for c, w in zip(np.unique(y_train), cw)}
 
print('\nClass indices :', train_data.class_indices)
print('Class weights :', {idx_to_class[k]: round(v, 3)
                          for k, v in class_weight_dict.items()})
 


# ── CELL 6: BUILD MODEL ───────────────────────────────────────────────
def build_model():
    base = EfficientNetB0(
        include_top=False,
        weights='imagenet',
        input_shape=(IMG_SIZE, IMG_SIZE, 3))
    base.trainable = False

    inp = keras.Input(shape=(IMG_SIZE, IMG_SIZE, 3))
    x = base(inp, training=False)
    x = layers.GlobalAveragePooling2D()(x)
    x = layers.BatchNormalization()(x)
    x = layers.Dense(256, activation='relu',
                     kernel_regularizer=regularizers.l2(L2_REG))(x)
    x = layers.Dropout(DROPOUT_1)(x)
    x = layers.Dense(128, activation='relu',
                     kernel_regularizer=regularizers.l2(L2_REG))(x)
    x = layers.Dropout(DROPOUT_2)(x)
    out = layers.Dense(NUM_CLASSES, activation='softmax')(x)
    return Model(inp, out, name='DERMIFY_EfficientNetB0'), base


model, base = build_model()

model.compile(
    optimizer=Adam(LR_P1),
    loss=keras.losses.CategoricalCrossentropy(label_smoothing=LABEL_SMOOTH),
    metrics=['accuracy'])

print(f'Backbone layers  : {len(base.layers)}')
print(f'Total params     : {model.count_params():,}')
print(f'Trainable params : {sum(int(tf.size(v)) for v in model.trainable_variables):,}')


# ── CELL 7: PHASE 1 — FROZEN BASE ─────────────────────────────────────
cb_p1 = [
    EarlyStopping(monitor='val_accuracy', patience=8,
                  restore_best_weights=True, verbose=1),
    ReduceLROnPlateau(monitor='val_loss', factor=0.5,
                      patience=4, min_lr=1e-7, verbose=1),
]
 
print('PHASE 1 — training head, base frozen')
history1 = model.fit(train_data, epochs=EPOCHS_P1, validation_data=val_data,
                     class_weight=class_weight_dict, callbacks=cb_p1, verbose=1)
print(f'\nPhase 1 best val_accuracy: {max(history1.history["val_accuracy"]):.4f}')


# ── CELL 8: PHASE 2 — FINE-TUNE ───────────────────────────────────────
# Unfreeze more of the backbone than before (from layer 150 rather than
# 100) with a cosine-decayed LR. BatchNorm layers stay frozen — unfreezing
# them with a small batch destabilises the running statistics.
 
base.trainable = True
for i, layer in enumerate(base.layers):
    if i < UNFREEZE_FROM or isinstance(layer, layers.BatchNormalization):
        layer.trainable = False
 
steps_per_epoch = int(np.ceil(train_data.samples / BATCH_SIZE))
cosine = keras.optimizers.schedules.CosineDecay(
    initial_learning_rate=LR_P2,
    decay_steps=EPOCHS_P2 * steps_per_epoch)
 
model.compile(
    optimizer=Adam(cosine),
    loss=keras.losses.CategoricalCrossentropy(label_smoothing=LABEL_SMOOTH),
    metrics=['accuracy'])
 
cb_p2 = [
    EarlyStopping(monitor='val_accuracy', patience=10,
                  restore_best_weights=True, verbose=1),
    ModelCheckpoint(MODEL_PATH, monitor='val_accuracy',
                    save_best_only=True, verbose=1),
]
 
print(f'Trainable params now: {sum(int(tf.size(v)) for v in model.trainable_variables):,}')
print('PHASE 2 — fine-tuning')
history2 = model.fit(train_data, epochs=EPOCHS_P2, validation_data=val_data,
                     class_weight=class_weight_dict, callbacks=cb_p2, verbose=1)
print(f'\nPhase 2 best val_accuracy: {max(history2.history["val_accuracy"]):.4f}')
 
# make sure a checkpoint exists even if Phase 2 never improved
if not os.path.exists(MODEL_PATH):
    model.save(MODEL_PATH)
    print('Phase 2 did not improve; saved current weights.')


# ── CELL 9: HONEST EVALUATION (identical code path for every split) ───
# This is the cell that answers "why is test above val?". Train, val and
# test are all scored the SAME way: best checkpoint loaded, inference
# mode, no augmentation. Any remaining difference is real.
 
model = keras.models.load_model(MODEL_PATH)
 
def evaluate_split(gen, name):
    gen.reset()
    probs = model.predict(gen, verbose=0)
    y_pred = np.argmax(probs, axis=1)
    y_true = gen.classes
    acc = accuracy_score(y_true, y_pred)
    f1m = f1_score(y_true, y_pred, average='macro')
    print(f'  {name:<12} accuracy {acc*100:>6.2f}%   macro-F1 {f1m*100:>6.2f}%   (n={len(y_true)})')
    return acc, f1m, probs, y_pred, y_true
 
print('=' * 60)
print('  APPLES-TO-APPLES EVALUATION')
print('=' * 60)
tr_acc, _, _, _, _              = evaluate_split(train_eval_data, 'Train')
va_acc, _, _, _, _              = evaluate_split(val_data,        'Validation')
te_acc, te_f1, probs, y_pred, y_true = evaluate_split(test_data,  'Test')
print('-' * 60)
 
# ---- overfitting diagnostic ----
gap = (tr_acc - va_acc) * 100
print(f'  Train - Val gap : {gap:+.2f} points')
if gap > 15:
    print('    -> OVERFITTING. Raise dropout, add augmentation, or unfreeze fewer layers.')
elif gap < 3:
    print('    -> UNDERFITTING. Train longer or unfreeze more layers.')
else:
    print('    -> Healthy generalisation gap.')
 
vt = (te_acc - va_acc) * 100
print(f'  Test  - Val gap : {vt:+.2f} points')
print('    On ~300-image splits, +/-4 points is ordinary sampling noise.')
print('    Report the cross-validated figure (CELL 12) as the headline number.')
print('=' * 60)


# ── CELL 10: TRAINING CURVES ──────────────────────────────────────────
def joined(h1, h2, key):
    return h1.history[key] + h2.history[key]
 
fig, ax = plt.subplots(1, 2, figsize=(14, 4.5))
n1 = len(history1.history['accuracy'])
 
ax[0].plot(joined(history1, history2, 'accuracy'), label='train')
ax[0].plot(joined(history1, history2, 'val_accuracy'), label='val')
ax[0].axvline(n1 - 0.5, color='gray', ls='--', lw=1)
ax[0].text(n1, ax[0].get_ylim()[0], ' fine-tune', color='gray', fontsize=9)
ax[0].set_title('Accuracy'); ax[0].set_xlabel('epoch'); ax[0].legend(); ax[0].grid(alpha=.3)
 
ax[1].plot(joined(history1, history2, 'loss'), label='train')
ax[1].plot(joined(history1, history2, 'val_loss'), label='val')
ax[1].axvline(n1 - 0.5, color='gray', ls='--', lw=1)
ax[1].set_title('Loss'); ax[1].set_xlabel('epoch'); ax[1].legend(); ax[1].grid(alpha=.3)
 
plt.suptitle('DERMIFY — training curves', fontweight='bold')
plt.tight_layout()
plt.savefig('/kaggle/working/training_curves.png', dpi=150, bbox_inches='tight')
plt.show()
