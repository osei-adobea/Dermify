<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Dark theme overrides -->
    <style name="Base.Theme.Dermify" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color (lighter teal pops against dark) -->
        <item name="colorPrimary">@color/teal_light</item>
        <item name="colorPrimaryDark">@color/teal_primary</item>
        <item name="colorOnPrimary">@color/teal_dark</item>
        <item name="colorPrimaryContainer">@color/teal_dark</item>
        <item name="colorOnPrimaryContainer">@color/teal_light</item>

        <!-- Secondary / accent -->
        <item name="colorSecondary">@color/coral_accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Backgrounds and surfaces -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnBackground">@color/on_surface_dark</item>
        <item name="colorOnSurface">@color/on_surface_dark</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant_dark</item>

        <!-- Error -->
        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/white</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

</resources>