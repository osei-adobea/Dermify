<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verify Result"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Is this diagnosis correct?"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvDisease"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Yes, This Is Correct"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnCorrect"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Correct the Label"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:id="@+id/layoutCorrection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="16dp"
            android:background="?attr/colorSurface">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Select the correct diagnosis:"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="10dp"/>

            <Spinner
                android:id="@+id/spinnerCorrection"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"
                android:popupBackground="?attr/colorSurface"
                android:popupElevation="8dp"
                android:spinnerMode="dropdown"/>

            <Button
                android:id="@+id/btnSubmitCorrection"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Submit Correction"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>