<navigation
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
android:id="@+id/nav_graph"
app:startDestination="@id/cameraFragment" >
<fragment
    android:id="@+id/cameraFragment"
    android:name="com.dermify.dermify.ui.camera.CameraFragment"
    android:label="Camera" >

    <action
        android:id="@+id/action_camera_to_result"
        app:destination="@id/resultFragment" />

</fragment>
<fragment
    android:id="@+id/resultFragment"
    android:name="com.dermify.dermify.ui.result.ResultFragment"
    android:label="Result" >

    <argument
        android:name="imagePath"
        app:argType="string" />

    <action
        android:id="@+id/action_result_to_verify"
        app:destination="@id/verifyFragment" />
    <action
        android:id="@+id/action_result_to_camera"
        app:destination="@id/cameraFragment"
        app:popUpTo="@id/cameraFragment"
        app:popUpToInclusive="true" />

</fragment>
<fragment
    android:id="@+id/verifyFragment"
    android:name="com.dermify.dermify.ui.verify.VerifyFragment"
    android:label="Verify" >

    <argument
        android:name="imagePath"
        app:argType="string" />
    <argument
        android:name="predictedDisease"
        app:argType="string" />

    <action
        android:id="@+id/action_verify_to_camera"
        app:destination="@id/cameraFragment"
        app:popUpTo="@id/cameraFragment"
        app:popUpToInclusive="true" />
    <action
        android:id="@+id/action_verify_to_consent"
        app:destination="@id/consentFragment" />

</fragment>
<fragment
    android:id="@+id/historyFragment"
    android:name="com.dermify.dermify.ui.history.HistoryFragment"
    android:label="History" >

    <action
        android:id="@+id/action_history_to_camera"
        app:destination="@id/cameraFragment"
        app:popUpTo="@id/cameraFragment"
        app:popUpToInclusive="true" />

</fragment>
<fragment
    android:id="@+id/consentFragment"
    android:name="com.dermify.dermify.ui.consent.ConsentFragment"
    android:label="Consent" >

    <argument
        android:name="imagePath"
        app:argType="string" />
    <argument
        android:name="label"
        app:argType="string" />
    <argument
        android:name="confidence"
        android:defaultValue="0.0"
        app:argType="float" />

    <action
        android:id="@+id/action_consent_to_camera"
        app:destination="@id/cameraFragment"
        app:popUpTo="@id/cameraFragment"
        app:popUpToInclusive="true" />

</fragment>
</navigation>